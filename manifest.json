{
  "schemaVersion": 1,
  "id": "marcford.gmessages",
  "name": "Google Messages",
  "version": "1.2.0",
  "author": "MarcFord",
  "description": "Read and reply to Google Messages from the Omarchy bar",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Google Messages",
    "description": "Unread badge with a full conversation panel: threads, history, images, voice messages, and replies",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "autostart": true,
      "serviceName": "gmessagesd.service",
      "cameraDevice": "/dev/video0",
      "audioDevice": "default",
      "normalizeVoice": true
    },
    "schema": [
      {
        "key": "autostart",
        "type": "boolean",
        "label": "Start gmessagesd automatically"
      },
      {
        "key": "serviceName",
        "type": "string",
        "label": "systemd user unit to start"
      },
      {
        "key": "cameraDevice",
        "type": "string",
        "label": "Webcam device for photo capture"
      },
      {
        "key": "audioDevice",
        "type": "string",
        "label": "PulseAudio/PipeWire source for voice messages"
      },
      {
        "key": "normalizeVoice",
        "type": "boolean",
        "label": "Normalise voice recording level"
      }
    ]
  }
}
